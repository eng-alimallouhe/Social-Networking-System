{
  "Subject": "You have been invited to join {{ProjectName}}",
  "Body": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Project Invitation</title>\n    <style>\n        @media only screen and (max-width: 600px) {\n            .container { width: 100% !important; border-radius: 0 !important; }\n            .inner-content { padding: 25px !important; }\n            .mobile-center { text-align: center !important; }\n        }\n    </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\n        <tr>\n            <td align=\"center\" style=\"padding: 40px 10px;\">\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\n                    <tr>\n                        <td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\">&nbsp;</td>\n                    </tr>\n                    <tr>\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\n                            <h1 style=\"color: #3f4d67; font-size: 28px; font-weight: 700; margin: 0 0 10px 0; line-height: 1.3;\">Project Invitation</h1>\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">Hello {{RecipientName}},</p>\n                            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 30px;\">\n                                <strong>{{ProjectOwnerName}}</strong> has invited you to participate in the project \"<strong>{{ProjectName}}</strong>\".\n                            </p>\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 30px; background-color: #f8f9fa; border-radius: 8px; padding: 15px; width: 100%;\">\n                                <tr>\n                                    <td width=\"60\" style=\"padding-right: 15px;\">\n                                        <img src=\"{{ProjectOwnerProfileImageUrl}}\" alt=\"Profile Image\" width=\"50\" height=\"50\" style=\"border-radius: 50%; display: block;\">\n                                    </td>\n                                    <td style=\"font-size: 16px; font-weight: bold; color: #333;\">\n                                        {{ProjectOwnerName}}\n                                    </td>\n                                </tr>\n                            </table>\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\n                                <tr>\n                                    <td align=\"center\">\n                                        <a href=\"{{InvitationUrl}}\" style=\"background-color: #00a180; color: #ffffff; text-decoration: none; padding: 12px 25px; border-radius: 6px; font-size: 16px; font-weight: bold; display: inline-block;\">Review Invitation</a>\n                                    </td>\n                                </tr>\n                            </table>\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 40px 0 30px 0;\">\n                                <tr>\n                                    <td style=\"border-top: 1px solid #dee2e6;\"></td>\n                                </tr>\n                            </table>\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"color: #999; font-size: 12px; line-height: 1.5;\">\n                                        <strong>&copy; 2026 SNS</strong><br>\n                                        All rights reserved.<br>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
}
