{
  "Subject": "Verify Your New Email Address",
  "Body": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Email Change Verification</title>\n    <style>\n        @media only screen and (max-width: 600px) {\n            .container { width: 100% !important; border-radius: 0 !important; }\n            .inner-content { padding: 25px !important; }\n            .mobile-center { text-align: center !important; }\n        }\n    </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\n        <tr>\n            <td align=\"center\" style=\"padding: 40px 10px;\">\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\n                    <tr>\n                        <td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\">&nbsp;</td>\n                    </tr>\n                    <tr>\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\n                            \n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\n                <tr>\n                    <td align=\"left\" class=\"mobile-center\">\n                        <img src=\"{{LogoUrl}}\" alt=\"Logo\" width=\"120\" style=\"display: block; outline: none; border: none; text-decoration: none;\">\n                    </td>\n                </tr>\n            </table>\n        \n                            <h1 style=\"color: #3f4d67; font-size: 28px; font-weight: 700; margin: 0 0 10px 0; line-height: 1.3;\">Email Change Verification</h1>\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">Hi {{UserName}},</p>\n                            \n                            \n            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 30px;\">\n                You requested to change your email address. Please use the verification code below to confirm this change.\n            </p>\n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f8f9fa\" style=\"border-radius: 8px; border: 1px solid #dee2e6; margin-bottom: 30px;\">\n                <tr>\n                    <td align=\"center\" style=\"padding: 30px;\">\n                        <span style=\"display: block; font-size: 12px; color: #3f4d67; text-transform: uppercase; font-weight: bold; letter-spacing: 1.5px; margin-bottom: 15px;\">Your Verification Code</span>\n                        <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 42px; font-weight: bold; color: #00a180; letter-spacing: 8px;\" dir=\"ltr\">\n                            {{Code}}\n                        </div>\n                    </td>\n                </tr>\n            </table>\n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 35px;\">\n                <tr>\n                    <td align=\"center\">\n                        <a href=\"{{RedirectUrl}}\" style=\"display: inline-block; background-color: #3f4d67; color: #f4f7fa; font-size: 16px; font-weight: bold; padding: 16px 45px; text-decoration: none; border-radius: 8px; letter-spacing: 0.5px;\">Confirm Change</a>\n                    </td>\n                </tr>\n            </table>\n        \n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 40px 0 30px 0;\">\n                                <tr>\n                                    <td style=\"border-top: 1px solid #dee2e6;\"></td>\n                                </tr>\n                            </table>\n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"color: #999; font-size: 12px; line-height: 1.5;\">\n                                        <strong>&copy; 2026 SNS</strong><br>\n                                        All rights reserved.<br>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
}