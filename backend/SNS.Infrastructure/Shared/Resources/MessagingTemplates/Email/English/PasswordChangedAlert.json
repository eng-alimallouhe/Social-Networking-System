{
  "subject": "Your password has been changed",
  "body": "<!DOCTYPE html>\r\n<html lang=\"en\" dir=\"ltr\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n    <title>Password Changed</title>\r\n    <style>\r\n        @media only screen and (max-width: 600px) {\r\n            .container { width: 100% !important; border-radius: 0 !important; }\r\n            .inner-content { padding: 25px !important; }\r\n            .mobile-center { text-align: center !important; }\r\n        }\r\n    </style>\r\n</head>\r\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\r\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\r\n        <tr>\r\n            <td align=\"center\" style=\"padding: 40px 10px;\">\r\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\r\n                    <tr><td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\">&nbsp;</td></tr>\r\n                    <tr>\r\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\r\n                                <tr><td align=\"left\" class=\"mobile-center\"><img src=\"{{logoUrl}}\" alt=\"Logo\" width=\"120\" style=\"display: block;\"></td></tr>\r\n                            </table>\r\n                            <h1 style=\"color: #3f4d67; font-size: 26px; font-weight: 700; margin: 0 0 10px 0;\">Password changed</h1>\r\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">Hi {{name}},</p>\r\n                            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 30px;\">\r\n                                Your account password has been successfully updated. If you made this update, no further action is required.\r\n                            </p>\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px; background-color: #fff9e6; border-left: 4px solid #ecc605; border-radius: 4px;\">\r\n                                <tr>\r\n                                    <td style=\"padding: 15px;\">\r\n                                        <p style=\"font-size: 13px; color: #856404; margin: 0; line-height: 1.5;\">\r\n                                            <strong>Security Alert:</strong> If you did not change your password, someone else may have access to your account. Click below to reset it now.\r\n                                        </p>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 35px;\">\r\n                                <tr><td align=\"center\"><a href=\"{{redirect_url}}\" style=\"display: inline-block; background-color: #3f4d67; color: #f4f7fa; font-size: 15px; font-weight: bold; padding: 15px 40px; text-decoration: none; border-radius: 8px;\">Secure Account</a></td></tr>\r\n                            </table>\r\n                            <hr style=\"border:none; border-top:1px solid #dee2e6; margin: 30px 0;\" />\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\r\n                                <tr><td align=\"center\" style=\"color: #999; font-size: 12px;\"><strong>&copy; 2026 Your Company Name</strong><br>All rights reserved.</td></tr>\r\n                            </table>\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n</html>\r\n"
}
