{
  "Subject": "Security Alert: High-Risk Login Attempt",
  "Body": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>High-Risk Login Attempt</title>\n    <style>\n        @media only screen and (max-width: 600px) {\n            .container { width: 100% !important; border-radius: 0 !important; }\n            .inner-content { padding: 25px !important; }\n            .mobile-center { text-align: center !important; }\n        }\n    </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\n        <tr>\n            <td align=\"center\" style=\"padding: 40px 10px;\">\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\n                    <tr>\n                        <td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\"> </td>\n                    </tr>\n                    <tr>\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\n                            \n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\n                <tr>\n                    <td align=\"left\" class=\"mobile-center\">\n                        <img src=\"{{LogoUrl}}\" alt=\"Logo\" width=\"120\" style=\"display: block; outline: none; border: none; text-decoration: none;\">\n                    </td>\n                </tr>\n            </table>\n        \n                            <h1 style=\"color: #3f4d67; font-size: 28px; font-weight: 700; margin: 0 0 10px 0; line-height: 1.3;\">High-Risk Login Attempt</h1>\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">Hi {{UserName}},</p>\n                            \n                            \n            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 25px;\">\n                We detected a high-risk login attempt to your account on <strong>{{OccuredDate}}</strong> from a <strong>{{Device}}</strong>.<br><br>Location: {{City}}, {{Country}}<br>IP Address: {{IpAddress}}<br><br>If this was not you, please secure your account immediately.\n            </p>\n\n            \n            <div style=\"background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin-bottom: 30px; border-radius: 4px;\">\n                <p style=\"margin: 0; font-size: 14px; color: #856404; line-height: 1.6;\">\n                    <strong>Security Action Taken:</strong> For your protection, we have temporarily locked your account from new login attempts for <strong>3 hours</strong>.\n                </p>\n            </div>\n        \n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 35px;\">\n                <tr>\n                    <td align=\"center\">\n                        <a href=\"https://www.google.com/maps/search/?api=1&query={{Latitude}},{{Longitude}}\" target=\"_blank\" style=\"display: inline-block; background-color: #f8f9fa; color: #00a180; font-size: 14px; font-weight: bold; padding: 12px 30px; text-decoration: none; border-radius: 8px; border: 1px solid #00a180;\">View Location on Map</a>\n                    </td>\n                </tr>\n            </table>\n        \n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 40px 0 30px 0;\">\n                                <tr>\n                                    <td style=\"border-top: 1px solid #dee2e6;\"></td>\n                                </tr>\n                            </table>\n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"color: #999; font-size: 12px; line-height: 1.5;\">\n                                        <strong>© 2026 SNS</strong><br>\n                                        All rights reserved.<br>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
}