{
  "Subject": "تنبيه تسجيل الدخول برمز الاسترداد",
  "Body": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>تسجيل الدخول برمز الاسترداد</title>\n    <style>\n        @media only screen and (max-width: 600px) {\n            .container { width: 100% !important; border-radius: 0 !important; }\n            .inner-content { padding: 25px !important; }\n            .mobile-center { text-align: center !important; }\n        }\n    </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\n        <tr>\n            <td align=\"center\" style=\"padding: 40px 10px;\">\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\n                    <tr>\n                        <td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\">&nbsp;</td>\n                    </tr>\n                    <tr>\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\n                            \n            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\n                <tr>\n                    <td align=\"right\" class=\"mobile-center\">\n                        <img src=\"{{LogoUrl}}\" alt=\"Logo\" width=\"120\" style=\"display: block; outline: none; border: none; text-decoration: none;\">\n                    </td>\n                </tr>\n            </table>\n        \n                            <h1 style=\"color: #3f4d67; font-size: 28px; font-weight: 700; margin: 0 0 10px 0; line-height: 1.3;\">تسجيل الدخول برمز الاسترداد</h1>\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">مرحباً {{UserName}}،</p>\n                            \n                            \n            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 30px;\">\n                تم الوصول للتو إلى حسابك باستخدام رمز استرداد احتياطي. إذا كنت أنت من قام بذلك، فلا داعي لاتخاذ أي إجراء. إذا لم تقم بذلك، يرجى تأمين حسابك على الفور.\n            </p>\n        \n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 40px 0 30px 0;\">\n                                <tr>\n                                    <td style=\"border-top: 1px solid #dee2e6;\"></td>\n                                </tr>\n                            </table>\n\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"color: #999; font-size: 12px; line-height: 1.5;\">\n                                        <strong>&copy; 2026 SNS</strong><br>\n                                        جميع الحقوق محفوظة.<br>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
}