{
  "subject": "تأكيد تغيير البريد الإلكتروني",
  "body": "<!DOCTYPE html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n    <title>تأكيد عنوان بريدك الإلكتروني الجديد</title>\r\n    <style>\r\n        @media only screen and (max-width: 600px) {\r\n            .container { width: 100% !important; border-radius: 0 !important; }\r\n            .inner-content { padding: 25px !important; }\r\n            .mobile-center { text-align: center !important; }\r\n        }\r\n    </style>\r\n</head>\r\n<body style=\"margin:0; padding:0; background-color:#f4f7fa; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#343a40;\">\r\n    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f7fa\">\r\n        <tr>\r\n            <td align=\"center\" style=\"padding: 40px 10px;\">\r\n                <table class=\"container\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" bgcolor=\"#ffffff\" style=\"border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #dee2e6;\">\r\n                    \r\n                    <tr>\r\n                        <td height=\"6\" bgcolor=\"#00a180\" style=\"font-size: 0px; line-height: 0px;\">&nbsp;</td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td class=\"inner-content\" style=\"padding: 50px 40px;\">\r\n                            \r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px;\">\r\n                                <tr>\r\n                                    <td align=\"right\" class=\"mobile-center\">\r\n                                        <img src=\"{{logoUrl}}\" alt=\"Logo\" width=\"120\" style=\"display: block; outline: none; border: none; text-decoration: none;\">\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                            <h1 style=\"color: #3f4d67; font-size: 28px; font-weight: 700; margin: 0 0 10px 0; line-height: 1.3;\">تأكيد بريدك الإلكتروني الجديد</h1>\r\n                            <p style=\"font-size: 16px; color: #343a40; margin: 0 0 25px 0;\">مرحباً {{name}}،</p>\r\n                            \r\n                            <p style=\"font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 30px;\">\r\n                                لقد طلبت مؤخراً تغيير عنوان البريد الإلكتروني لحسابك. لإكمال العملية وتأمين حسابك، يرجى تأكيد هذا التغيير.\r\n                            </p>\r\n\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 30px; background-color: #fff9e6; border-right: 4px solid #ecc605; border-radius: 4px;\">\r\n                                <tr>\r\n                                    <td style=\"padding: 15px;\">\r\n                                        <p style=\"font-size: 13px; color: #856404; margin: 0; line-height: 1.5;\">\r\n                                            <strong>تنبيه أمني:</strong> إذا لم تطلب هذا التغيير، يرجى الاتصال بفريق الدعم لدينا فوراً لتأمين حسابك.\r\n                                        </p>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f8f9fa\" style=\"border-radius: 8px; border: 1px solid #dee2e6; margin-bottom: 30px;\">\r\n                                <tr>\r\n                                    <td align=\"center\" style=\"padding: 30px;\">\r\n                                        <span style=\"display: block; font-size: 12px; color: #3f4d67; text-transform: uppercase; font-weight: bold; letter-spacing: 1.5px; margin-bottom: 15px;\">رمز التأكيد</span>\r\n                                        <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 42px; font-weight: bold; color: #00a180; letter-spacing: 8px;\" dir=\"ltr\">\r\n                                            {{code}}\r\n                                        </div>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 35px;\">\r\n                                <tr>\r\n                                    <td align=\"center\">\r\n                                        <a href=\"{{redirect_url}}\" style=\"display: inline-block; background-color: #3f4d67; color: #f4f7fa; font-size: 16px; font-weight: bold; padding: 16px 45px; text-decoration: none; border-radius: 8px; letter-spacing: 0.5px;\">تأكيد البريد الإلكتروني الجديد</a>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                            <p style=\"font-size: 13px; line-height: 1.6; color: #999; text-align: center; margin: 0;\">\r\n                                تنتهي صلاحية رابط التأكيد هذا خلال 30 دقيقة.\r\n                            </p>\r\n\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 40px 0 30px 0;\">\r\n                                <tr>\r\n                                    <td style=\"border-top: 1px solid #dee2e6;\"></td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                            <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\r\n                                <tr>\r\n                                    <td align=\"center\" style=\"color: #999; font-size: 12px; line-height: 1.5;\">\r\n                                        <strong>&copy; 2026 اسم شركتك</strong><br>\r\n                                        جميع الحقوق محفوظة. قم بحماية حسابك من خلال عدم مشاركة رموزك أبداً.<br>\r\n                                        <a href=\"#\" style=\"color: #00a180; text-decoration: none;\">سياسة الخصوصية</a> &nbsp;&bull;&nbsp; <a href=\"#\" style=\"color: #00a180; text-decoration: none;\">الدعم الفني</a>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n</html>\r\n"
}
